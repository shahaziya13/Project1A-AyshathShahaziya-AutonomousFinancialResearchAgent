# ============================================
# Autonomous Financial Research Agent
# Environment Configuration Example
# ============================================

# Application
APP_NAME=Autonomous Financial Research Agent
APP_ENV=development
LOG_LEVEL=INFO

# --------------------------------------------
# LLM Configuration
# --------------------------------------------

# Use "mock" when no API key is configured.
# Change to "openai" when using the OpenAI API.
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000

# Retry configuration
LLM_MAX_RETRIES=5
LLM_RETRY_MIN_SECONDS=1
LLM_RETRY_MAX_SECONDS=16

# --------------------------------------------
# Vector Database
# --------------------------------------------

CHROMA_PERSIST_DIRECTORY=chromadb_data
CHROMA_COLLECTION_NAME=financial_research_memory

# --------------------------------------------
# Financial / Search APIs
# These will be configured during Day 5.
# --------------------------------------------

ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
TAVILY_API_KEY=
NEWS_API_KEY=

# --------------------------------------------
# SEC EDGAR
# --------------------------------------------

SEC_USER_AGENT=ARA-1 Financial Research Agent